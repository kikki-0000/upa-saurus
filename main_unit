# --- Logic Processing Functions ---
def process_hand_signals():
    global punchType, petType
    # Interprets received hand signals to determine the type of punch or pet.
    if right_hand == "head_right" or left_hand == "head_left":
        punchType = 1
    elif right_hand == "body_right" or left_hand == "body_left":
        punchType = 2
    elif right_hand == "tail_right" or left_hand == "tail_left":
        punchType = 3
    elif right_hand == "idle_right" and left_hand == "idle_left":
        punchType = 4
    elif right_hand == "P:head_right" or left_hand == "P:head_left":
        petType = 1
    elif right_hand == "P:body_right" or left_hand == "P:body_left":
        petType = 2
    elif right_hand == "P:tail_right" or left_hand == "P:tail_left":
        petType = 3
