def on_forever():
    # This function runs repeatedly in the background and controls the main game logic.
    process_hand_signals()
    # Always interpret hand signals
    if [0, 2, 8].index_of(gameState2) >= 0:
        handle_state_transitions()
    elif [3, 4, 5].index_of(gameState2) >= 0:
        handle_battle_state()
    elif [9, 10, 11].index_of(gameState2) >= 0:
        handle_petting_state()
    elif gameState2 == 7:
        play_victory_animation()
    elif gameState2 == 12:
        play_affection_max_animation()
    elif gameState2 == 6:
        gameOver()
basic.forever(on_forever)
