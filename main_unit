# --- Global Variable Declarations ---
def update_led_strip():
    global target_range2
    # Updates the LED strip color based on HP.
    # Only update the LED during battle states
    if [3, 4, 5].index_of(gameState2) < 0:
        return
    if gameState2 == 3:
        target_range2 = range1
    elif gameState2 == 4:
        target_range2 = range2
    elif gameState2 == 5:
        target_range2 = range3
    # 2.「HP」の値に応じて、色や点滅を制御する
    if HP >= 70:
        target_range2.show_color(neopixel.rgb(0, 255, 0))
    elif HP >= 50:
        # 緑
        target_range2.show_color(neopixel.rgb(255, 255, 0))
    elif HP >= 30:
        target_range2.show_color(neopixel.rgb(255, 0, 0))
    elif HP >= 10:
        for index in range(4):
            target_range2.show_color(neopixel.rgb(255, 0, 0))
            basic.pause(500)
            strip.show_color(neopixel.colors(NeoPixelColors.BLACK))
            basic.pause(500)
    elif HP > 0:
        for index2 in range(4):
            target_range2.show_color(neopixel.rgb(255, 0, 0))
            basic.pause(200)
            strip.show_color(neopixel.colors(NeoPixelColors.BLACK))
            basic.pause(200)
