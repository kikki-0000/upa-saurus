def handle_battle_state():
    global HP, gameState2
    damage = 0
    # Handles the logic for battle states (3, 4, 5).
    update_led_strip()
    # Always update LED based on HP
    basic.show_number(HP)
    # Determine damage based on the state and punch type
    if gameState2 == 3:
        # head
        start_time2 = input.running_time()
        # ループ開始時の時間を記録
        # stateが3の間、このループを繰り返す
        while gameState2 == 3:
            # 1. HPを表示
            basic.show_number(HP)
            # 2. パンチ入力をチェック
            process_hand_signals()
            # この関数でpunchの値が更新されると仮定
            if punchType == 1:
                HP += 0 - 10
                gameState2 = 2
                # 攻撃成功、次のステートへ
                break
            # ループを抜ける
            # 3. タイムオーバーをチェック
            passed_time2 = input.running_time() - start_time2
            if passed_time2 >= 10000:
                # 10秒経過したら
                gameState2 = 6
                # タイムオーバー
                break
    elif gameState2 == 4:
        # Body
        start_time2 = input.running_time()
        # ループ開始時の時間を記録
        # stateが3の間、このループを繰り返す
        while gameState2 == 4:
            # 1. HPを表示
            basic.show_number(HP)
            # 2. パンチ入力をチェック
            process_hand_signals()
            # この関数でpunchの値が更新されると仮定
            if punchType == 2:
                HP += 0 - 20
                gameState2 = 2
                # 攻撃成功、次のステートへ
                break
            # ループを抜ける
            # 3. タイムオーバーをチェック
            passed_time2 = input.running_time() - start_time2
            if passed_time2 >= 10000:
                # 10秒経過したら
                gameState2 = 6
                # タイムオーバー
                break
    elif gameState2 == 5:
        # Tail
        start_time2 = input.running_time()
        # ループ開始時の時間を記録
        # stateが3の間、このループを繰り返す
        while gameState2 == 5:
            # 1. HPを表示
            basic.show_number(HP)
            # 2. パンチ入力をチェック
            process_hand_signals()
            # この関数でpunchの値が更新されると仮定
            if punchType == 3:
                HP += 0 - 30
                gameState2 = 2
                # 攻撃成功、次のステートへ
                break
            # ループを抜ける
            # 3. タイムオーバーをチェック
            passed_time2 = input.running_time() - start_time2
            if passed_time2 >= 10000:
                # 10秒経過したら
                gameState2 = 6
                # タイムオーバー
                break
    # If damage was dealt, reduce HP and move to the next state
    # If the punch missed or was invalid, maintain the current state
    if damage > 0:
        HP += 0 - damage
        gameState2 = 2
    elif punchType == 0 or punchType == 7:
        pass
    elif punchType != 0:
        # If it was an invalid punch to a valid part
        gameState2 = 2
